# Atlas AI OS Configuration
# Copy this file to .env and configure your settings

# Application
ATLAS_APP_NAME="Atlas AI OS"
ATLAS_APP_VERSION="0.1.0"
ATLAS_ENVIRONMENT="development"
ATLAS_DEBUG="true"

# Database
ATLAS_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/atlas"
ATLAS_DB_ECHO="false"
ATLAS_DB_POOL_SIZE="20"
ATLAS_DB_MAX_OVERFLOW="10"

# Redis
ATLAS_REDIS_URL="redis://localhost:6379/0"
ATLAS_REDIS_DB="0"
ATLAS_REDIS_PASSWORD=""
ATLAS_REDIS_MAX_CONNECTIONS="50"

# LLM Provider
ATLAS_LLM_PROVIDER="openai"
ATLAS_LLM_API_KEY=""
ATLAS_LLM_BASE_URL=""
ATLAS_LLM_MODEL="gpt-4"
ATLAS_LLM_TEMPERATURE="0.7"
ATLAS_LLM_MAX_TOKENS="128000"
ATLAS_LLM_REQUEST_TIMEOUT="60"

# Security
ATLAS_SECURITY_SECRET_KEY="change-me-in-production-use-a-long-random-string"
ATLAS_SECURITY_ALGORITHM="HS256"
ATLAS_SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES="30"
ATLAS_SECURITY_REFRESH_TOKEN_EXPIRE_DAYS="7"

# API
ATLAS_API_HOST="0.0.0.0"
ATLAS_API_PORT="8000"
ATLAS_API_WORKERS="4"
ATLAS_API_RELOAD="true"
ATLAS_API_LOG_LEVEL="info"
ATLAS_API_CORS_ORIGINS="*"
ATLAS_API_RATE_LIMIT_PER_MINUTE="60"

# Sandbox
ATLAS_SANDBOX_ENABLED="true"
ATLAS_SANDBOX_DOCKER_ENABLED="true"
ATLAS_SANDBOX_DOCKER_IMAGE="atlas-sandbox:latest"
ATLAS_SANDBOX_MEMORY_LIMIT="512m"
ATLAS_SANDBOX_CPU_LIMIT="1.0"
ATLAS_SANDBOX_TIMEOUT_SECONDS="300"
ATLAS_SANDBOX_MAX_CONCURRENT="10"
ATLAS_SANDBOX_NETWORK_ENABLED="false"
